# 203.76: hardened unit for TVStreammerSAT5.
#
#   sudo install -m 0644 packaging/systemd/tvstreammersat5.service \
#        /etc/systemd/system/tvstreammersat5.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now tvstreammersat5.service
#   journalctl -u tvstreammersat5.service -n 50 --no-pager
#
# The service intentionally still runs as root: it opens /dev/dvb/* frontends,
# listens on low ports for some deployments, controls oscam-mini.service and
# restarts itself through `systemctl --no-block`. Everything below narrows what
# root can touch without changing that contract.
[Unit]
Description=TVStreammerSAT5 IPTV/DVB streaming server
Documentation=https://github.com/Monkipnet/Tvstreamer_sat
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/TVStreammerSAT5
ExecStart=/opt/TVStreammerSAT5/TVStreammerSAT5
Restart=on-failure
RestartSec=3
TimeoutStopSec=35
LimitNOFILE=65536

# Privilege and filesystem hardening.
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=no

# ProtectSystem=full keeps /usr, /boot and /etc read-only while leaving /opt and
# the working directory writable, which is where the configuration, the HLS
# storage and the replacement files live.
ReadWritePaths=/opt/TVStreammerSAT5 /var/lib/tvstreammersat5

# PrivateTmp is deliberately NOT enabled: the default HLS storage directory is
# /tmp/tvstreammersat5-hls, and operators often inspect it while debugging. Set
# HLS storage to /var/lib/tvstreammersat5/hls in the panel before enabling it.

[Install]
WantedBy=multi-user.target
